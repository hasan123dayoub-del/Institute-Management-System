PORT=5000
# Creating a student, moving a student and finishing a course use transactions, and MongoDB only allows them on a
# replica set. Easiest: run `npm run db` in another terminal (a local replica set on port 27019), then use this line.
# Or use MongoDB Atlas, or your own mongod started with --replSet rs0.
MONGO_URI=mongodb://127.0.0.1:27019/ascend?replicaSet=rs0
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Used by npm run seed
ADMIN_EMAIL=admin@ascend.academy
ADMIN_PASSWORD=change-me-123
ADMIN_NAME=Admin
