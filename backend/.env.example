PORT=5000
# Transactions (create student, move student, finish class) need a replica set:
# use MongoDB Atlas, or run local mongod with --replSet rs0.
MONGO_URI=mongodb://127.0.0.1:27017/ascend?replicaSet=rs0
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Used by npm run seed
ADMIN_EMAIL=admin@ascend.academy
ADMIN_PASSWORD=change-me-123
ADMIN_NAME=Admin
